# Copie para .env e substitua os marcadores. Nunca versione o arquivo .env.
PROJECT_DATABASE_URL=mysql+pymysql://USUARIO_PROJETOS:SENHA@localhost:3306/gestao_projetos_sisfron?charset=utf8mb4

# Use obrigatoriamente um usuario com privilegio SELECT apenas em producao.
COST_DATABASE_URL=mysql+pymysql://USUARIO_SOMENTE_LEITURA:SENHA@localhost:3306/gestao_custos_sisfron?charset=utf8mb4
CORS_ORIGINS=http://localhost:5174

# Gere uma chave longa e aleatoria para producao.
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES
JWT_EXPIRE_MINUTES=480
